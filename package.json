{
  "name": "joplin-plugin-tts",
  "version": "0.3.0",
  "description": "Read the open Joplin note aloud, sentence by sentence, with voice, play/pause and speed controls.",
  "scripts": {
    "dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && webpack --env joplin-plugin-config=createArchive",
    "prepare": "npm run dist",
    "updateVersion": "webpack --env joplin-plugin-config=updateVersion",
    "version:set": "node .github/scripts/set-version.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "badges": "node .github/scripts/coverage-badges.cjs --badges .github/badges",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run coverage && npm run badges"
  },
  "license": "MIT",
  "author": "rafaeljpc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaeljpc/joplin-tts-plugin.git"
  },
  "keywords": [
    "joplin-plugin"
  ],
  "files": [
    "publish"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.0",
    "chalk": "^4.1.0",
    "copy-webpack-plugin": "^11.0.0",
    "eslint": "^9.17.0",
    "fs-extra": "^10.1.0",
    "glob": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.4.2",
    "tar": "^6.1.11",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}
